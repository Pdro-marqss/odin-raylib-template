{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "debug",
            "detail": "Compila com simbolos de debug em build/debug/",
            "type": "shell",
            "command": "odin run tools/build.odin -file -- debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "odin",
                "source": "odin",
                "severity": "error",
                "fileLocation": "autoDetect",
                "pattern": {
                    "regexp": "^(.+?)\\((\\d+):(\\d+)\\)\\s+(?:Syntax )?Error:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "release",
